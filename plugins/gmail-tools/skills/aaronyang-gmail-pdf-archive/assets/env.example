# Copy this file to .env and replace the placeholders. Never commit .env.

# One variable per password key used in targets.toml.
# password = "ID" in targets.toml reads PDF_PASSWORD_ID.
PDF_PASSWORD_ID=replace-me
PDF_PASSWORD_CARD=replace-me

# Optional. Also copy decrypted PDFs to <EXPORT_PATH>/YYYY-MM.
EXPORT_PATH=
